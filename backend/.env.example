# ---- Backend (Railway) ----

# Your TypeSafe API key. Get it from your TypeSafe dashboard. Server-side only.
TYPESAFE_API_KEY=sk-...

# Optional: pin a model version instead of the moving alias.
# JEV_MODEL=jev-1.13.0

# Run with fake verdicts and NO API key (local UI work / offline).
# MOCK=true

# The frontend origin(s) allowed to call this API (CORS). Comma-separate for
# production + Vercel preview URLs. Must be the exact scheme+host, no trailing slash.
FRONTEND_ORIGIN=https://petty-judge.vercel.app,http://localhost:5173
